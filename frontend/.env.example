# Copy to frontend/.env and adjust if your backend runs somewhere else.
#
# Anything prefixed VITE_ is compiled into the browser bundle, so treat every
# value here as public. Never put a real secret in this file — a Google client
# SECRET, for instance, belongs nowhere near the frontend.

# Where the Spring Boot API is listening.
VITE_API_URL=http://localhost:8080

# Google OAuth *client ID* — public by design; it identifies the app to Google
# and is visible in any browser. Sign-in uses the ID-token flow, so there is no
# client secret in this project at all. See docs/GOOGLE_OAUTH_SETUP.md.
# Leave blank to hide the Google button and use email/password only.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
